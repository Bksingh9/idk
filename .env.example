# =============================================================================
# PlaytestPool — environment variables
# -----------------------------------------------------------------------------
# Copy to .env.local and fill in. The app validates this file at startup
# (src/lib/config/env.ts) and REFUSES TO BOOT if anything required is missing
# or malformed. Never commit .env.local — only this example is tracked.
#
# Tiers:
#   [CORE]     required always; app will not boot without them
#   [PROVIDER] required for the related feature; validated-if-present otherwise
# =============================================================================

# --- App ---------------------------------------------------------------------
# [CORE]
NODE_ENV=development
# Public base URL of the app (used for redirects, CORS allow-list, email links).
APP_BASE_URL=http://localhost:3000
# Comma-separated list of origins allowed by CORS. Locked down by default.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Log level: trace|debug|info|warn|error|fatal
LOG_LEVEL=info

# --- Auth security boundary (Layer 10) ---------------------------------------
# [CORE] Secret used to sign app session/refresh JWTs. Min 32 chars.
# Generate: openssl rand -base64 48
AUTH_JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
# Access token TTL (seconds) and refresh token TTL (seconds).
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=1209600

# --- MongoDB (Layer 3 — durable data) ----------------------------------------
# [CORE] For local proving, `pnpm infra:up` starts MongoDB at this URI.
# In prod, use MongoDB Atlas: mongodb+srv://<user>:<pw>@<cluster>/?retryWrites=true
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=playtestpool

# --- Redis (Layers 3/6/8 — cache, rate-limit, sessions) ----------------------
# [CORE] `pnpm infra:up` starts a Redis at this URL.
# In prod, use Upstash TLS URL: rediss://default:<token>@<host>:6379
REDIS_URL=redis://localhost:6379

# --- Supabase (OPTIONAL — not used by the product path) ----------------------
# The product uses built-in JWT auth + Postgres (DATABASE_URL). These are only
# needed if you opt back into Supabase integrations. Leave blank to disable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (Layer set up now; used in Phase 5) ------------------------------
# [PROVIDER] Test-mode keys from https://dashboard.stripe.com/test/apikeys
# Leave blank to disable; if set, must be well-formed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_INDIE=
STRIPE_PRICE_STUDIO=

# --- Resend (transactional email) --------------------------------------------
# [PROVIDER] API key from https://resend.com/api-keys
# Leave blank to log emails to the console instead of sending.
RESEND_API_KEY=
EMAIL_FROM=PlaytestPool <onboarding@resend.dev>

# --- Sentry (Layer 7 — error reporting) --------------------------------------
# [PROVIDER] DSN from https://sentry.io → Project → Settings → Client Keys.
# Leave blank to disable error reporting (logs still emitted locally).
SENTRY_DSN=

# --- Resilience tuning (Layer 5) — sane defaults, override if needed ----------
EXTERNAL_CALL_TIMEOUT_MS=5000
EXTERNAL_CALL_MAX_RETRIES=3
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_RESET_MS=15000

# --- Rate limiting (Layer 6) -------------------------------------------------
RATE_LIMIT_PER_USER_PER_MIN=60
RATE_LIMIT_GLOBAL_PER_MIN=1000
# Signups per rate-limit window per IP. Keep low in production; the E2E suite
# raises this (it signs up many users from one IP within a single window).
SIGNUP_RATE_LIMIT=10

# --- Admin (Phase 6) ---------------------------------------------------------
# Comma-separated emails allowed into the admin view (/admin). Leave blank to
# disable admin access entirely.
ADMIN_EMAILS=
